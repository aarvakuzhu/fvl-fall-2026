# Copy this file to .env for local development. On Render, set these as
# real Environment Variables in the service settings instead of a file.

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fvl-draft?retryWrites=true&w=majority

# Port to listen on locally (Render sets this automatically in production)
PORT=3000

# Tournament Director password — gates write access to the one official
# draft. Defaults to 2026 if unset; change this before the
# real auction.
TD_PASSWORD=2026
